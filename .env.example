# kai 環境變數範例 — 複製為 .env 後填入
#
# .env 只放 API 金鑰與 docker 服務設定；其他調校參數建議放 .kai/config.json
# （執行 /init-config 可互動匯出目前所有設定與預設值）

# ── 模型 ──────────────────────────────────────────────────────────────
# 預設模型，可用清單見 core/models.py 的 REGISTRY
MODEL=qwen3-vl:4b

# 模型顯示暱稱：NICKNAME_<模型名稱，特殊字元換成底線>
# NICKNAME_qwen3_vl_4b=小Q

# 對話泡泡顯示的使用者名稱
# USERNAME=你

# ── API 金鑰（使用對應後端時才需要） ────────────────────────────────────
# Google Gemini：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# Jina Reader（可選，有 key 的 fetch_url 額度較高）：https://jina.ai/
JINA_API_KEY=
# Context7 MCP（可選，於 mcp_servers.json 引用）：https://context7.com/
CONTEXT7_API_KEY=

# ── 搜尋（SearXNG，docker compose up -d） ─────────────────────────────────
SEARXNG_URL=http://localhost:8888/search
# SearXNG session secret，必填；產生方式：openssl rand -hex 32
SEARXNG_SECRET=

# ── TTS：Azure（可選） ────────────────────────────────────────────────
AZURE_TTS_KEY=
AZURE_TTS_REGION=
# AZURE_TTS_ENDPOINT=

# ── Dify RAG 知識庫（可選） ──────────────────────────────────────────────
# DIFY_API_URL=http://localhost
DIFY_API_KEY=
# DIFY_RERANK_PROVIDER=xinference
# DIFY_RERANK_MODEL=

# ── PostgreSQL（可選，docker compose --profile db up -d） ────────────────
# POSTGRES_DB=kai
# POSTGRES_USER=kai
# POSTGRES_PASSWORD=kai
