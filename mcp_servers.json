{
  "mcpServers": {
    "_twstock-db": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://mcpuser:REDACTED@localhost:5432/twstock"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/user/projects"]
    },
    "_playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser", "chromium", "--no-sandbox"],
      "env": {
        "DISPLAY": ":0"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
      }
    },
    "RepoMapper": {
      "command": "/home/user/RepoMapper/.venv/bin/python",
      "args": ["/home/user/RepoMapper/repomap_server.py"]
    }
  }
}
