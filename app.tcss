/* ─── 主佈局 ─── */
Screen {
    layout: vertical;
}

* {
    scrollbar-size: 1 1;
    scrollbar-background: transparent;
    scrollbar-color: $panel;
    scrollbar-color-hover: $panel-lighten-2;
    scrollbar-color-active: $primary;
}

#app-grid {
    height: 1fr;
}

/* ─── 中央標籤面板 ─── */
#center-tabs {
    width: 1fr;
}

#center-tabs TabPane {
    padding: 0;
    height: 1fr;
}

#center-tabs TextArea {
    height: 1fr;
    border: none;
}


#messages {
    width: 1fr;
    padding: 0 2 1 2;
    scrollbar-gutter: stable;
}

/* ─── 檔案樹 ─── */
#file-tree {
    width: 28;
    background: $surface;
    overflow-y: auto;
}

#file-tree Tree {
    background: transparent;
    padding: 0 0 0 1;
}

/* ─── 拖拉分隔條 ─── */
ResizeHandle {
    width: 1;
    background: $surface-lighten-1;
}

ResizeHandle:hover {
    background: $panel-lighten-2;
}

ResizeHandle.dragging {
    background: $primary;
}

/* ─── 側邊欄 ─── */
#sidebar {
    width: 26;
    background: $surface;
    padding: 0 1 1 1;
    overflow-y: auto;
}

.sidebar-title {
    color: $accent;
    text-style: bold;
    margin: 1 0 0 0;
    padding: 0;
}

.sidebar-content {
    color: $text-muted;
    padding: 0 0 0 1;
    margin: 0;
}

/* ─── 訊息 ─── */
#welcome {
    border: round $surface;
    color: $text-muted;
    padding: 1 2;
    margin: 1 0;
    text-align: center;
}

.user-bubble {
    border-left: thick $primary;
    background: $primary-background;
    padding: 0 1;
    margin: 1 0 0 0;
}

/* ─── 圖片訊息 ─── */
.image-bubble {
    height: auto;
    border-left: thick $primary;
    background: $primary-background;
    padding: 0 1 0 1;
    margin: 1 0 0 0;
}

.image-bubble-header {
    margin: 0;
    padding: 0;
}

.image-question {
    color: $text-muted;
    margin: 0;
    padding: 0;
}

.img-open-btn {
    height: 1;
    min-width: 10;
    margin: 0 0 0 0;
    border: none;
    background: $surface;
    color: $text-muted;
}

.img-open-btn:hover {
    background: $primary-background;
    color: $primary;
}

.ai-header {
    color: $success;
    text-style: bold;
    margin: 1 0 0 0;
    padding: 0 1;
}

.thinking {
    border: round $warning;
    margin: 1 0 0 0;
}

.error-msg {
    border-left: thick $error;
    color: $error;
    padding: 0 1;
    margin: 1 0;
}

.bash-output {
    border-left: thick $panel;
    background: $surface;
    color: $text;
    padding: 0 1;
    margin: 0 0 1 0;
}

/* ─── AI 回應 ─── */
AIMessage {
    height: auto;
    border-left: thick $surface;
    background: $boost;
    margin: 0 0 0 0;
}

AIMessage .stream-view {
    height: auto;
    max-width: 100%;
    padding: 0 1 0 1;
    margin: 0;
    background: transparent;
    overflow-x: auto;
}

AIMessage .md-view {
    display: none;
    height: auto;
    padding: 0 1 0 1;
    margin: 0;
    border: none;
    background: transparent;
}

AIMessage:focus, AIMessage .md-view:focus {
    border: none;
}


AIMessage .ta-view {
    display: none;
    height: 5;
    background: transparent;
    border: none;
    scrollbar-size: 1 1;
}

AIMessage.select-mode .stream-view {
    display: none;
}

AIMessage.select-mode .md-view {
    display: none;
}

AIMessage.select-mode .ta-view {
    display: block;
}

.stats {
    color: $text-muted;
    text-align: right;
    padding: 0 1;
    margin: 0 0 1 0;
}

/* ─── 工具除錯卡片 ─── */
.tool-debug {
    border-left: thick $warning;
    margin: 0 0 0 0;
    background: $boost;
}

.tool-debug > CollapsibleTitle {
    color: $warning;
}

.tool-debug-error {
    border-left: thick $error;
}

.tool-debug-error > CollapsibleTitle {
    color: $error;
}

/* ─── 補全下拉 ─── */
AutoComplete {
    max-height: 12;
    border: round $primary;
    background: $surface;
}

AutoComplete .autocomplete--highlight-match {
    text-style: bold;
    color: $accent;
}

/* ─── 輸入列 ─── */
#input-row {
    height: 3;
    align: left middle;
}

#prompt {
    width: 1fr;
    border: round $primary;
    margin: 0 1 0 1;
    background: $boost;
    scrollbar-size-horizontal: 0;
}

#prompt:focus {
    border: round $accent;
}

#prompt.streaming {
    border: round $warning;
    border-title-color: $warning;
}

/* ─── 功能標籤列 ─── */
#cap-bar {
    height: 2;
    align: left middle;
    padding: 0 2;
}

.cap-badge {
    height: 1;
    min-width: 8;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: $primary-background;
    color: $primary;
}

.cap-badge:hover {
    background: $primary;
    color: $background;
}

.cap-badge.cap-think-on {
    background: $warning-darken-2;
    color: $warning;
}

.cap-badge.cap-think-on:hover {
    background: $warning;
    color: $background;
}

.cap-badge.cap-inactive {
    background: $surface;
    color: $text-muted;
}

.cap-badge.cap-unsupported {
    background: transparent;
    color: $text-muted;
    text-style: dim;
}

.cap-badge.cap-label {
    width: auto;
    background: $primary-background;
    color: $primary;
}

/* ─── 程式碼複製按鈕 ─── */
.copy-btn {
    dock: right;
    width: 3;
    height: 1;
    min-width: 3;
    background: transparent;
    border: none;
    color: $text-muted;
    padding: 0;
}

.copy-btn:hover {
    background: $primary-background;
    color: $accent;
}

/* ─── 未存檔關閉確認對話框 ─── */
ConfirmCloseScreen {
    align: center middle;
}

.confirm-dialog {
    width: 50;
    height: auto;
    background: $surface;
    border: tall $primary;
    padding: 1 2;
}

.confirm-title {
    text-align: center;
    margin-bottom: 1;
}

.confirm-body {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

.confirm-buttons {
    align: center middle;
    height: auto;
    margin-top: 1;
}

.confirm-buttons Button {
    margin: 0 1;
}

/* ─── Markdown 表格：防止撐爆版面 ─── */
MarkdownTable {
    max-width: 100%;
    overflow-x: auto;
}

MarkdownTableContent {
    max-width: 100%;
}

/* ─── 附件按鈕（Static，不是 Button，無 border 問題）─── */
.attach-btn {
    width: 3;
    height: 3;
    background: transparent;
    margin: 0 0 0 1;
    padding: 1 0 0 0;
    content-align: center top;
    color: $text-muted;
}

.attach-btn:hover {
    background: $boost;
    color: $text;
}

/* ─── Sidebar CWD 可點擊標題（Static）─── */
.sidebar-title-btn {
    width: 1fr;
    height: 1;
    background: transparent;
    color: $accent;
    text-style: bold;
    padding: 0 1;
}

.sidebar-title-btn:hover {
    background: $boost;
    color: $text;
}
